---
import "../styles/global.css";

import { PixelHeart } from "../components/ui/pixel";
import { Search } from "../components/search";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/newsletter-scraper/favicon.svg"
    />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#ff85c2" />
    <meta name="generator" content={Astro.generator} />
    <title>Newsletter Scraper</title>
  </head>
  <body class="y2k-bg crt min-h-screen font-sans text-ink">
    <Search client:only="solid-js" />

    <footer
      class="y2k-taskbar fixed bottom-0 inset-x-0 z-20 flex items-center justify-between gap-2 px-3 py-1.5"
    >
      <span class="y2k-taskitem">
        <PixelHeart class="w-3 h-3 text-hotpink" />
        <span class="font-pixel text-[8px] leading-none text-ink hidden sm:inline"
          >NEWSLETTER_SCRAPER.EXE</span
        >
      </span>
      <p class="font-pixel text-[8px] leading-none text-ink flex items-center gap-1.5">
        MADE BY
        <a
          href="https://github.com/carlosqsilva"
          target="_blank"
          rel="noreferrer"
          class="text-hotpink underline decoration-2 underline-offset-2 hover:text-ink transition-colors duration-100"
        >
          CARLOS_SILVA
        </a>
      </p>
    </footer>
  </body>
</html>
